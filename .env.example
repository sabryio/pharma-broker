# ============================================================
# Bridge Settings (Go WhatsApp Bridge)
# ============================================================

# gRPC Core address
# Docker: core:50051
# Local:  localhost:50051
BRIDGE_GRPC_CORE_ADDR=core:50051

# WhatsApp session database path
# Docker: /app/data/whatsapp.db
# Local:  ./data/whatsapp.db
BRIDGE_WHATSAPP_STORE_PATH=/app/data/whatsapp.db

# Show QR code in terminal
BRIDGE_WHATSAPP_QR_TERMINAL=true

# HTTP server mode (debug, release, test)
BRIDGE_HTTP_MODE=release
