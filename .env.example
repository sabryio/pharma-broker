# PharmaBroker Environment Configuration
# Copy this file to .env and fill in your values
#
# Environment variable format: PB_{SECTION}_{KEY}
# Example: PB_GEMINI_API_KEY, PB_REPORTS_TELEGRAM_ENABLED

# ============================================================
# AI Provider Settings
# ============================================================

# Select AI provider: "gemini" or "docker"
PB_AI_PROVIDER=docker

# Google Gemini API Key (for ai.provider = "gemini")
PB_GEMINI_API_KEY=your-gemini-api-key-here

# Docker Model Runner Settings (for ai.provider = "docker")
# When running in Docker Compose, the model-runner binds automatically
PB_DOCKER_MODEL_BASE_URL=http://model-runner.docker.internal/engines/llama.cpp/v1
PB_DOCKER_MODEL_MODEL=ai/qwen3-vl:latest
PB_DOCKER_MODEL_EMBEDDING_MODEL_NAME=ai/embeddinggemma

# ============================================================
# Database Settings (PostgreSQL)
# ============================================================

# Main PharmaBroker database
# Docker: postgres://postgres:password@postgres:5432/pharmabroker?sslmode=disable
# Local:  postgres://postgres:password@localhost:5432/pharmabroker?sslmode=disable
PB_DATABASE_DSN=postgres://postgres:password@localhost:5432/pharmabroker?sslmode=disable

# WhatsApp session database (separate for isolation)
# Docker: postgres://postgres:password@postgres:5432/whatsapp_sessions?sslmode=disable
# Local:  postgres://postgres:password@localhost:5432/whatsapp_sessions?sslmode=disable
PB_WHATSAPP_SESSION_DB_DSN=postgres://postgres:password@localhost:5432/whatsapp_sessions?sslmode=disable

# Connection pool settings (optional)
# PB_DATABASE_MAX_OPEN_CONNS=25
# PB_DATABASE_MAX_IDLE_CONNS=5
# PB_DATABASE_CONN_MAX_LIFETIME_MINS=5

# Raw message retention in days
PB_DATABASE_RAW_RETENTION_DAYS=30

# ============================================================
# Telegram Notifications (under reports.telegram.*)
# ============================================================

# Enable Telegram notifications
PB_REPORTS_TELEGRAM_ENABLED=false

# Telegram Bot Token (get from @BotFather)
PB_REPORTS_TELEGRAM_BOT_TOKEN=your-bot-token-here

# Telegram Chat IDs (comma-separated, group IDs have - prefix)
PB_REPORTS_TELEGRAM_CHAT_IDS=-123456789,987654321

# ============================================================
# Email Notifications (under reports.email.*)
# ============================================================

# Enable Email notifications
PB_REPORTS_EMAIL_ENABLED=false

# SMTP Server Settings
PB_REPORTS_EMAIL_SMTP_HOST=smtp.gmail.com
PB_REPORTS_EMAIL_SMTP_PORT=587
PB_REPORTS_EMAIL_USERNAME=your-email@gmail.com
PB_REPORTS_EMAIL_PASSWORD=your-app-password

# Sender Details
PB_REPORTS_EMAIL_FROM_NAME=PharmaBroker
PB_REPORTS_EMAIL_FROM_EMAIL=your-email@gmail.com

# Recipients (comma-separated)
PB_REPORTS_EMAIL_RECIPIENTS=admin@example.com,manager@example.com

# ============================================================
# Reports Settings
# ============================================================

# Enable automated hourly reports
PB_REPORTS_ENABLED=true

# Report interval (e.g., "1h", "30m")
PB_REPORTS_INTERVAL=1h

# ============================================================
# WhatsApp Settings
# ============================================================

# Admin phone for WhatsApp management
PB_WHATSAPP_ADMIN_PHONE=+201234567890

# Session directory for WhatsApp Web data files
PB_WHATSAPP_SESSION_DIR=./data/whatsapp

# ============================================================
# Server Settings
# ============================================================

# API server port
PB_SERVER_PORT=8080

# Health check port
PB_SERVER_HEALTH_PORT=5050

# ============================================================
# Parser Settings
# ============================================================

# Match threshold (0.0-1.0)
PB_PARSER_MATCH_THRESHOLD=0.5

# Batch processing interval
PB_PARSER_BATCH_INTERVAL=5s
