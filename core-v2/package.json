{
  "name": "core-v2",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "@orpc/server": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "better-auth": "^1.4.9",
      "@prisma/client": "^7.1.0",
      "@orpc/client": "^1.12.2",
      "effect": "^3.19.14",
      "@effect/platform": "^0.94.1",
      "@effect/sql": "^0.49.0",
      "@effect/sql-pg": "^0.50.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @core-v2/db db:push",
    "db:studio": "turbo -F @core-v2/db db:studio",
    "db:generate": "turbo -F @core-v2/db db:generate",
    "db:migrate": "turbo -F @core-v2/db db:migrate"
  },
  "dependencies": {
    "@core-v2/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@core-v2/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
